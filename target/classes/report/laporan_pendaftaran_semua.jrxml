<?xml version="1.0" encoding="UTF-8"?>
<!-- Laporan seluruh transaksi pendaftaran SIKURSUS - JasperReports 6.21.x -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_pendaftaran_semua"
              pageWidth="1008" pageHeight="612" columnWidth="960"
              leftMargin="24" rightMargin="24" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="SIKURSUS MySQL"/>

    <style name="TitleStyle" fontName="SansSerif" fontSize="18" isBold="true" forecolor="#17365D"/>
    <style name="SubtitleStyle" fontName="SansSerif" fontSize="8" forecolor="#64748B"/>
    <style name="SectionStyle" fontName="SansSerif" fontSize="8" isBold="true" forecolor="#17365D"/>
    <style name="HeaderStyle" mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF" fontName="SansSerif" fontSize="7" isBold="true" hTextAlign="Center" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
            <pen lineWidth="0.4" lineColor="#FFFFFF"/>
        </box>
    </style>
    <style name="DetailStyle" mode="Opaque" backcolor="#FFFFFF" forecolor="#243247" fontName="SansSerif" fontSize="7" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
            <pen lineWidth="0.35" lineColor="#D8E1EC"/>
        </box>
    </style>
    <style name="FooterStyle" fontName="SansSerif" fontSize="7" forecolor="#64748B"/>

    <queryString language="SQL"><![CDATA[
SELECT
    p.id_pendaftaran,
    p.tanggal_daftar,
    p.status AS status_pendaftaran,
    ps.nim,
    ps.nama AS nama_peserta,
    ps.jenis_kelamin,
    ps.prodi,
    kls.nama_kelas,
    kls.tanggal_mulai,
    krs.kode_kursus,
    krs.nama_kursus,
    krs.level AS level_kursus,
    krs.biaya,
    ins.nama AS nama_instruktur,
    ins.keahlian
FROM pendaftaran p
INNER JOIN peserta ps ON p.id_peserta = ps.id_peserta
INNER JOIN kelas kls ON p.id_kelas = kls.id_kelas
INNER JOIN kursus krs ON kls.id_kursus = krs.id_kursus
INNER JOIN instruktur ins ON kls.id_instruktur = ins.id_instruktur
ORDER BY p.id_pendaftaran ASC
    ]]></queryString>

    <field name="id_pendaftaran" class="java.lang.Integer"/>
    <field name="tanggal_daftar" class="java.sql.Date"/>
    <field name="status_pendaftaran" class="java.lang.String"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_peserta" class="java.lang.String"/>
    <field name="jenis_kelamin" class="java.lang.String"/>
    <field name="prodi" class="java.lang.String"/>
    <field name="nama_kelas" class="java.lang.String"/>
    <field name="tanggal_mulai" class="java.sql.Date"/>
    <field name="kode_kursus" class="java.lang.String"/>
    <field name="nama_kursus" class="java.lang.String"/>
    <field name="level_kursus" class="java.lang.String"/>
    <field name="biaya" class="java.math.BigDecimal"/>
    <field name="nama_instruktur" class="java.lang.String"/>
    <field name="keahlian" class="java.lang.String"/>

    <variable name="TOTAL_PENDAFTARAN" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{id_pendaftaran}]]></variableExpression>
    </variable>

    <title>
        <band height="66">
            <staticText>
                <reportElement x="0" y="5" width="960" height="27"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN SELURUH PENDAFTARAN KURSUS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="34" width="960" height="16" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[SIKURSUS DESKTOP  |  SISTEM INFORMASI KURSUS]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="59" width="960" height="1" forecolor="#3B82F6"/>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="28">
            <staticText>
                <reportElement x="0" y="7" width="180" height="14"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[DAFTAR PENDAFTARAN TERDAFTAR]]></text>
            </staticText>
            <textField pattern="dd MMMM yyyy">
                <reportElement x="760" y="7" width="200" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="30">
            <staticText><reportElement style="HeaderStyle" x="0" y="0" width="32" height="30"/><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="32" y="0" width="62" height="30"/><text><![CDATA[TGL DAFTAR]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="94" y="0" width="50" height="30"/><text><![CDATA[STATUS]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="144" y="0" width="60" height="30"/><text><![CDATA[NIM]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="204" y="0" width="90" height="30"/><text><![CDATA[NAMA PESERTA]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="294" y="0" width="25" height="30"/><text><![CDATA[JK]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="319" y="0" width="65" height="30"/><text><![CDATA[PRODI]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="384" y="0" width="60" height="30"/><text><![CDATA[KELAS]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="444" y="0" width="62" height="30"/><text><![CDATA[TGL MULAI]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="506" y="0" width="52" height="30"/><text><![CDATA[KODE]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="558" y="0" width="105" height="30"/><text><![CDATA[NAMA KURSUS]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="663" y="0" width="42" height="30"/><text><![CDATA[LEVEL]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="705" y="0" width="70" height="30"/><text><![CDATA[BIAYA (Rp)]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="775" y="0" width="85" height="30"/><text><![CDATA[INSTRUKTUR]]></text></staticText>
            <staticText><reportElement style="HeaderStyle" x="860" y="0" width="100" height="30"/><text><![CDATA[KEAHLIAN]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField><reportElement style="DetailStyle" x="0" y="0" width="32" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression></textField>
            <textField pattern="dd-MM-yyyy"><reportElement style="DetailStyle" x="32" y="0" width="62" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{tanggal_daftar}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="94" y="0" width="50" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{status_pendaftaran}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="144" y="0" width="60" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="204" y="0" width="90" height="25"/><textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="294" y="0" width="25" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{jenis_kelamin}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="319" y="0" width="65" height="25"/><textFieldExpression><![CDATA[$F{prodi}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="384" y="0" width="60" height="25"/><textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression></textField>
            <textField pattern="dd-MM-yyyy"><reportElement style="DetailStyle" x="444" y="0" width="62" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{tanggal_mulai}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="506" y="0" width="52" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{kode_kursus}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="558" y="0" width="105" height="25"/><textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="663" y="0" width="42" height="25"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{level_kursus}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="DetailStyle" x="705" y="0" width="70" height="25"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{biaya}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="775" y="0" width="85" height="25"/><textFieldExpression><![CDATA[$F{nama_instruktur}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement style="DetailStyle" x="860" y="0" width="100" height="25"/><textFieldExpression><![CDATA[$F{keahlian}]]></textFieldExpression></textField>
        </band>
    </detail>


    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="0" width="960" height="1" forecolor="#D8E1EC"/></line>
            <staticText><reportElement style="FooterStyle" x="0" y="5" width="300" height="12"/><text><![CDATA[SIKURSUS Desktop - Laporan Pendaftaran]]></text></staticText>
            <textField>
                <reportElement style="FooterStyle" x="820" y="5" width="140" height="12"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="32">
            <line><reportElement x="0" y="3" width="960" height="1" forecolor="#CBD5E1"/></line>
            <staticText>
                <reportElement x="0" y="10" width="150" height="16" forecolor="#17365D"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL PENDAFTARAN:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="10" width="80" height="16" forecolor="#17365D"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_PENDAFTARAN}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
