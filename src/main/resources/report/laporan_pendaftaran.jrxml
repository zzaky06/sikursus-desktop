<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="laporan_pendaftaran"
    pageWidth="842" pageHeight="595" orientation="Landscape"
    columnWidth="794" leftMargin="24" rightMargin="24"
    topMargin="20" bottomMargin="20">

    <property name="com.jaspersoft.studio.data.defaultdataadapter"
        value="SIKURSUS MySQL"/>

    <!-- PARAMETER ID PENDAFTARAN TERPILIH -->
    <parameter name="P_ID_PENDAFTARAN"
        class="java.lang.Integer"/>

    <!-- QUERY KHUSUS SATU PENDAFTARAN -->
    <queryString language="SQL"><![CDATA[
SELECT
    p.id_pendaftaran,
    p.tanggal_daftar,
    p.status AS status_pendaftaran,
    ps.nim,
    ps.nama AS nama_peserta,
    ps.prodi,
    kls.nama_kelas,
    krs.kode_kursus,
    krs.nama_kursus,
    krs.level AS level_kursus,
    krs.biaya,
    ins.nama AS nama_instruktur
FROM pendaftaran p
INNER JOIN peserta ps
    ON p.id_peserta = ps.id_peserta
INNER JOIN kelas kls
    ON p.id_kelas = kls.id_kelas
INNER JOIN kursus krs
    ON kls.id_kursus = krs.id_kursus
INNER JOIN instruktur ins
    ON kls.id_instruktur = ins.id_instruktur
WHERE p.id_pendaftaran = $P{P_ID_PENDAFTARAN}
ORDER BY p.id_pendaftaran ASC
    ]]></queryString>

    <!-- FIELD DATABASE -->
    <field name="id_pendaftaran" class="java.lang.Integer"/>
    <field name="tanggal_daftar" class="java.sql.Date"/>
    <field name="status_pendaftaran" class="java.lang.String"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_peserta" class="java.lang.String"/>
    <field name="prodi" class="java.lang.String"/>
    <field name="nama_kelas" class="java.lang.String"/>
    <field name="kode_kursus" class="java.lang.String"/>
    <field name="nama_kursus" class="java.lang.String"/>
    <field name="level_kursus" class="java.lang.String"/>
    <field name="biaya" class="java.math.BigDecimal"/>
    <field name="nama_instruktur" class="java.lang.String"/>

    <!-- JUDUL LAPORAN -->
    <title>
        <band height="100">

            <staticText>
                <reportElement x="0" y="12"
                    width="794" height="30"
                    forecolor="#17365D"/>
                <textElement textAlignment="Center"
                    verticalAlignment="Middle">
                    <font fontName="SansSerif"
                        size="21" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA PENDAFTARAN]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="43"
                    width="794" height="20"
                    forecolor="#64748B"/>
                <textElement textAlignment="Center"
                    verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[SIKURSUS DESKTOP | SISTEM INFORMASI KURSUS]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="69"
                    width="794" height="1"
                    forecolor="#3B82F6"/>
            </line>

            <staticText>
                <reportElement x="0" y="75"
                    width="794" height="15"
                    forecolor="#17365D"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif"
                        size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[DETAIL PENDAFTARAN PESERTA TERPILIH]]></text>
            </staticText>

        </band>
    </title>

    <!-- HEADER TABEL -->
    <columnHeader>
        <band height="34">

            <staticText>
                <reportElement x="0" y="0" width="35" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="35" y="0" width="65" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[TANGGAL]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="0" width="55" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[NIM]]></text>
            </staticText>

            <staticText>
                <reportElement x="155" y="0" width="105" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[NAMA PESERTA]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="0" width="75" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[PRODI]]></text>
            </staticText>

            <staticText>
                <reportElement x="335" y="0" width="55" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[KELAS]]></text>
            </staticText>

            <staticText>
                <reportElement x="390" y="0" width="120" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[NAMA KURSUS]]></text>
            </staticText>

            <staticText>
                <reportElement x="510" y="0" width="65" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[LEVEL]]></text>
            </staticText>

            <staticText>
                <reportElement x="575" y="0" width="75" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[BIAYA]]></text>
            </staticText>

            <staticText>
                <reportElement x="650" y="0" width="90" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[INSTRUKTUR]]></text>
            </staticText>

            <staticText>
                <reportElement x="740" y="0" width="54" height="34"
                    mode="Opaque" backcolor="#17365D" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- DETAIL DATA -->
    <detail>
        <band height="30">

            <rectangle>
                <reportElement x="0" y="0"
                    width="794" height="30"
                    mode="Opaque" backcolor="#EFF5FB">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="0" y="0" width="35" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression>
            </textField>

            <textField pattern="dd-MM-yyyy">
                <reportElement x="35" y="0" width="65" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tanggal_daftar}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="100" y="0" width="55" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="155" y="0" width="105" height="30"/>
                <box leftPadding="5">
                    <pen lineWidth="0.4" lineColor="#D5DFEA"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="260" y="0" width="75" height="30"/>
                <box leftPadding="4">
                    <pen lineWidth="0.4" lineColor="#D5DFEA"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{prodi}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="335" y="0" width="55" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="390" y="0" width="120" height="30"/>
                <box leftPadding="5">
                    <pen lineWidth="0.4" lineColor="#D5DFEA"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="510" y="0" width="65" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{level_kursus}]]></textFieldExpression>
            </textField>

            <textField pattern="'Rp' #,##0">
                <reportElement x="575" y="0" width="75" height="30"/>
                <box rightPadding="4">
                    <pen lineWidth="0.4" lineColor="#D5DFEA"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{biaya}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="650" y="0" width="90" height="30"/>
                <box leftPadding="4">
                    <pen lineWidth="0.4" lineColor="#D5DFEA"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_instruktur}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="740" y="0" width="54" height="30"/>
                <box><pen lineWidth="0.4" lineColor="#D5DFEA"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status_pendaftaran}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- FOOTER -->
    <pageFooter>
        <band height="28">

            <line>
                <reportElement x="0" y="0"
                    width="794" height="1"
                    forecolor="#CBD5E1"/>
            </line>

            <staticText>
                <reportElement x="0" y="7"
                    width="400" height="18"
                    forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[SIKURSUS Desktop | Laporan Administrasi]]></text>
            </staticText>

            <textField>
                <reportElement x="694" y="7"
                    width="100" height="18"
                    forecolor="#64748B"/>
                <textElement textAlignment="Right"
                    verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- TOTAL -->
    <summary>
        <band height="38">

            <line>
                <reportElement x="0" y="5"
                    width="794" height="1"
                    forecolor="#17365D"/>
            </line>

            <staticText>
                <reportElement x="0" y="12"
                    width="110" height="20"
                    forecolor="#17365D"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL PENDAFTARAN:]]></text>
            </staticText>

            <textField>
                <reportElement x="112" y="12"
                    width="100" height="20"
                    forecolor="#17365D"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT} + " Data"]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
